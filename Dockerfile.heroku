FROM node:22.23.4-bookworm-slim

ARG NEXT_PUBLIC_VERSION=v1.47.0
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
ENV NEXT_TELEMETRY_DISABLED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    nginx \
    postgresql-client \
    bash \
  && rm -rf /var/lib/apt/lists/*

# Install Temporal Server 1.28.1, temporal-sql-tool, Temporal CLI 1.4.1, and PostgreSQL v12 schemas
RUN mkdir -p /tmp/temporal-dl /etc/temporal \
  && curl -fsSL https://github.com/temporalio/temporal/releases/download/v1.28.1/temporal_1.28.1_linux_amd64.tar.gz \
    | tar -xz -C /tmp/temporal-dl \
  && mv /tmp/temporal-dl/temporal-server /usr/local/bin/temporal-server \
  && mv /tmp/temporal-dl/temporal-sql-tool /usr/local/bin/temporal-sql-tool \
  && curl -fsSL https://github.com/temporalio/cli/releases/download/v1.4.1/temporal_cli_1.4.1_linux_amd64.tar.gz \
    | tar -xz -C /tmp/temporal-dl \
  && mv /tmp/temporal-dl/temporal /usr/local/bin/temporal \
  && curl -fsSL https://github.com/temporalio/temporal/archive/refs/tags/v1.28.1.tar.gz \
    | tar -xz -C /etc/temporal --strip-components=1 temporal-1.28.1/schema/postgresql/v12 \
  && rm -rf /tmp/temporal-dl \
  && chmod +x /usr/local/bin/temporal-server /usr/local/bin/temporal-sql-tool /usr/local/bin/temporal \
  && temporal-server --version \
  && temporal-sql-tool --version \
  && temporal --version

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2 \
  && npm cache clean --force

WORKDIR /app

COPY . /app

# Single layer install + build + aggressive cleanup to stay well under Heroku builder RAM & image size limits
RUN apt-get update && apt-get install -y --no-install-recommends g++ make python3 \
  && pnpm install --frozen-lockfile --store-dir /tmp/pnpm-store \
  && rm -rf /tmp/pnpm-store /root/.local/share/pnpm /root/.cache /root/.npm \
  && apt-get purge -y --auto-remove g++ make python3 \
  && rm -rf /var/lib/apt/lists/* \
  && echo "=== Building frontend ===" && df -h / \
  && NODE_OPTIONS="--max-old-space-size=2048" pnpm --filter ./apps/frontend run build \
  && rm -rf /app/apps/frontend/.next/cache \
  && find /app/apps/frontend/.next -name "*.map" -delete \
  && echo "=== Building backend ===" && df -h / \
  && NODE_OPTIONS="--max-old-space-size=2048" pnpm --filter ./apps/backend run build \
  && find /app/apps/backend/dist \( -name "*.d.ts" -o -name "*.tsbuildinfo" \) -delete \
  && echo "=== Building orchestrator ===" && df -h / \
  && NODE_OPTIONS="--max-old-space-size=2048" pnpm --filter ./apps/orchestrator run build \
  && find /app/apps/orchestrator/dist \( -name "*.d.ts" -o -name "*.tsbuildinfo" \) -delete \
  && echo "=== Finalizing permissions ===" && df -h / \
  && chmod +x /app/var/heroku/entrypoint.sh \
  && mkdir -p /uploads /app/apps/frontend/.next/cache /var/lib/nginx /var/log/nginx \
  && chmod -R a+rwX /uploads /app/apps/frontend/.next/cache /var/lib/nginx /var/log/nginx

CMD ["/app/var/heroku/entrypoint.sh"]
